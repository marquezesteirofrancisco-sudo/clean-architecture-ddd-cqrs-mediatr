@model IEnumerable<CleanArchitectureTemplate.Application.DTOs.ProductDTO>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Lista de Productos</h1>
    <a asp-controller="Products" asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Producto
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No hay productos registrados en el sistema actualmente.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 10%">ID</th>
                    <th scope="col" style="width: 50%">Nombre</th>
                    <th scope="col" style="width: 20%">Precio</th>
                    <th scope="col" style="width: 20%" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td><strong>#@producto.Id</strong></td>
                        <td>@producto.Nombre</td>
                        @* Formateamos el precio como moneda corriente de forma limpia *@
                        <td>@producto.Precio.ToString("C")</td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-controller="Products" asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-warning">
                                    Editar
                                </a>
                                <a asp-controller="Products" asp-action="Eliminar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este producto?');">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}