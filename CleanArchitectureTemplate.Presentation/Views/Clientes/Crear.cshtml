@model CleanArchitectureTemplate.Application.DTOs.ClienteDTO
@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h2 class="h5 mb-0">Crear Nuevo Cliente</h2>
            </div>
            <div class="card-body">

                <form asp-action="Crear" method="post">
                    @* Resumen de errores de validación del lado del servidor *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre del Cliente</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Camiseta azul - Talla M" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="500" placeholder="Descripción breve del cliente (máx. 500 caracteres)"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Direccion" class="form-label">Dirección</label>
                        <textarea asp-for="Direccion" class="form-control" rows="4" maxlength="500" placeholder="Direccion del cliente"></textarea>
                        <span asp-validation-for="Direccion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ciudad" class="form-label">Ciudad</label>
                        <textarea asp-for="Ciudad" class="form-control" rows="4" maxlength="500" placeholder="Ciudad del cliente"></textarea>
                        <span asp-validation-for="Ciudad" class="text-danger small"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="CodigoPostal" class="form-label">C.P.</label>
                        <textarea asp-for="CodigoPostal" class="form-control" rows="4" maxlength="500" placeholder="Codigo Postal del cliente"></textarea>
                        <span asp-validation-for="CodigoPostal" class="text-danger small"></span>
                    </div>


                    <hr class="my-4" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Guardar Cliente
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Habilita la validación en el cliente (jQuery Validation) sin recargar la página *@
    <partial name="_ValidationScriptsPartial" />
}