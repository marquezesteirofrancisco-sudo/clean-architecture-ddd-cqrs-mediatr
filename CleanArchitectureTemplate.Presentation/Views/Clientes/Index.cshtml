@model IEnumerable<CleanArchitectureTemplate.Application.DTOs.ClienteDTO>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Lista de Clientes</h1>
    <a asp-controller="Clientes" asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Cliente
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No hay clientes registrados en el sistema actualmente.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 10%">ID</th>
                    <th scope="col" style="width: 20%">Nombre</th>
                    <th scope="col" style="width: 20%">Descripcion</th>
                    <th scope="col" style="width: 10%">Direccion</th>
                    <th scope="col" style="width: 10%">Ciudad</th>
                    <th scope="col" style="width: 10%">C.P.</th>
                    <th scope="col" style="width: 20%" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td><strong>#@cliente.Id</strong></td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Descripcion</td>
                        <td>@cliente.Direccion</td>
                        <td>@cliente.Ciudad</td>
                        <td>@cliente.CodigoPostal</td>
                        
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-controller="Clientes" asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-warning">
                                    Editar
                                </a>
                                <a asp-controller="Clientes" asp-action="Eliminar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este cliente?');">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}